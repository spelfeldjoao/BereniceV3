int Sair_Do_Sistema(const Sistema *Sis)
{
    if (Sis->Caixa_Aberto)
    {
        printf("\nFeche o caixa antes de sair!\n");
        Pausar();
        return 0;
    }

    if (Confirmar("\nDeseja gravar os dados em arquivo?"))
    {
        if (Gravar_Dados(Sis))
        {
            printf("Dados gravados com sucesso!\n");
        }
        else
        {
            printf("Erro ao gravar os arquivos!\n");
        }
    }

    Imprimir_Titulo("PROGRAMA ENCERRADO - OBRIGADO!");
    return 1;
}

void Menu_Principal(Sistema *Sis)
{
    int Opcao;

    do
    {
        Limpar_Tela();
        Imprimir_Titulo("SISTEMA DA BERE 3");
        printf("|| Caixa: %s\n", Sis->Caixa_Aberto ? "ABERTO" : "FECHADO");
        printf("|| 1 - Cadastros\n");
        printf("|| 2 - Vendas\n");
        printf("|| 3 - Abertura de Caixa\n");
        printf("|| 4 - Fechamento de Caixa\n");
        printf("|| 5 - Relatorios\n");
        printf("|| 6 - Sair\n");

        Opcao = Ler_Int("Escolha uma opcao: ");

        switch (Opcao)
        {
            case 1: Menu_Cadastros(Sis);   break;
            case 2: Menu_Vendas(Sis);      break;
            case 3: Abrir_Caixa(Sis);      break;
            case 4: Fechar_Caixa(Sis);     break;
            case 5: Menu_Relatorios(Sis);  break;
            case 6:
                if (!Sair_Do_Sistema(Sis))
                {
                    Opcao = 0;             // --> CONTINUA NO MENU
                }
                break;
            default:
                printf("Opcao invalida!\n");
                Pausar();
        }
    } while (Opcao != 6);
}

void Liberar_Sistema(Sistema *Sis)
{
    for (int i = 0; i < Sis->Quantidade_Vendas; i++)
    {
        free(Sis->vendas[i].Itens);    // --> PRIMEIRO OS ITENS DE CADA VENDA
    }

    free(Sis->clientes);
    free(Sis->produtos);
    free(Sis->vendas);
    free(Sis->pagamentos);
}

