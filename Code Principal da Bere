// |------ EXPLICAÇÃO DA PARTE DE PERSISTENCIA ------|

// OS DADOS SÃO SALVOS EM ARQUIVOS DE TEXTO, UM REGISTRO POR LINHA, COM OS CAMPOS SEPARADOS POR ( | ).
// POR ISSO O ( Ler_Texto ) TROCA ( | ) POR ( - ): UM ( | ) DENTRO DO TEXTO QUEBRARIA A LEITURA
//
// Gravar_Dados --> ABRE CADA ARQUIVO COM ( fopen "w" ), QUE CRIA OU SOBRESCREVE, ESCREVE COM ( fprintf ) E FECHA COM ( fclose ). RETORNA 1 SE DEU CERTO E 0 SE NÃO ABRIU
//     O ARQUIVO DE VENDAS MISTURA DOIS TIPOS DE LINHA:  V|...  É O CABEÇALHO DA VENDA  /  I|...  É UM ITEM QUE PERTENCE À ÚLTIMA VENDA ( V ) ACIMA DELE
//
// Carregar_Dados --> LÊ OS ARQUIVOS SE EXISTIREM. SE NÃO EXISTIR, ( fopen ) RETORNA NULL E O BLOCO É PULADO
//     ( fgets ) LÊ UMA LINHA, ( strcspn ) TIRA O ENTER E ( sscanf ) SEPARA OS CAMPOS
//     NO ( sscanf ): ( %99[^|] ) LÊ ATÉ 99 CARACTERES PARANDO NO ( | ). O LIMITE EVITA ESTOURAR O BUFFER.
//     ( %lf ) LÊ UM ( double ) ( NO printf É ( %f ), MAS NO scanf PRECISA SER ( %lf ) ). ( %c ) LÊ UM CARACTERE
//     O RETORNO DO ( sscanf ) É QUANTOS CAMPOS FORAM LIDOS. COMPARANDO COM O ESPERADO ( == 7, == 8 ... ) DESCARTA LINHAS CORROMPIDAS
//     PARA PRODUTOS, TAMBÉM DESCARTA CATEGORIA FORA DE 1 A 3, POIS ELA É USADA COMO ÍNDICE DE ( Nomes_Categoria )
//     NAS VENDAS, A LINHA V CRIA UMA VENDA NOVA E A LINHA I ADICIONA O ITEM NA ÚLTIMA VENDA LIDA ( Quantidade_Vendas - 1 )
//     NO FINAL, SE NÃO HOUVER PRODUTOS ( PRIMEIRA EXECUÇÃO ), CARREGA OS PRODUTOS DE EXEMPLO

// |------ FIM DA EXPLICAÇÃO DA PARTE DE PERSISTENCIA ------|

// |---------------------------------------------------------|

// |------ INICIO DE PERSISTENCIA ------|

int Gravar_Dados(const Sistema *Sis)
{
    FILE *F;

    F = fopen(Arquivo_Clientes, "w");
    if (F == NULL) return 0;
    for (int i = 0; i < Sis->Quantidade_Clientes; i++)
    {
        const Cliente *C = &Sis->clientes[i];
        fprintf(F, "%d|%s|%s|%s|%s|%s|%s\n", C->Codigo, C->Nome, C->NomeSocial,
                C->Cpf, C->Rua_e_Numero, C->Bairro, C->Celular);
    }
    fclose(F);

    F = fopen(Arquivo_Produtos, "w");
    if (F == NULL) return 0;
    for (int i = 0; i < Sis->Quantidade_Produtos; i++)
    {
        const Produto *P = &Sis->produtos[i];
        fprintf(F, "%d|%s|%d|%.2f|%.2f|%d|%d|%d\n", P->Codigo, P->Descricao,
                P->Categoria, P->Preco_Compra, P->Margem_Lucro, P->Estoque,
                P->Estoque_Minimo, P->Ativo);
    }
    fclose(F);

    F = fopen(Arquivo_Vendas, "w");
    if (F == NULL) return 0;
    for (int i = 0; i < Sis->Quantidade_Vendas; i++)
    {
        const Venda *V = &Sis->vendas[i];
        fprintf(F, "V|%d|%c|%.2f|%.2f|%.2f\n", V->Numero, V->Situacao,
                V->Percentual_Desconto, V->SubTotal, V->Total);
        for (int j = 0; j < V->Quantidade_Itens; j++)
        {
            const Item_Venda *It = &V->Itens[j];
            fprintf(F, "I|%d|%s|%.2f|%d|%.2f\n", It->Codigo, It->Descricao,
                    It->Preco_Venda, It->Quantidade, It->Total);
        }
    }
    fclose(F);

    F = fopen(Arquivo_Pagamentos, "w");
    if (F == NULL) return 0;
    for (int i = 0; i < Sis->Quantidade_Pagamentos; i++)
    {
        const Pagamento *Pg = &Sis->pagamentos[i];
        fprintf(F, "%d|%.2f|%s|%.2f|%.2f\n", Pg->Numero_Venda, Pg->Valor_Pago,
                Pg->Tipo, Pg->Valor_Dinheiro, Pg->Valor_Cartao);
    }
    fclose(F);

    return 1;
}

void Carregar_Dados(Sistema *Sis)
{
    FILE *F;
    char  Linha[Tamanho_Linha];

    // --> CLIENTES
    F = fopen(Arquivo_Clientes, "r");
    if (F != NULL)
    {
        while (fgets(Linha, sizeof Linha, F) != NULL)
        {
            Cliente C;
            Linha[strcspn(Linha, "\r\n")] = '\0';

            if (sscanf(Linha, "%d|%99[^|]|%99[^|]|%14[^|]|%99[^|]|%49[^|]|%19[^|]",
                       &C.Codigo, C.Nome, C.NomeSocial, C.Cpf,
                       C.Rua_e_Numero, C.Bairro, C.Celular) == 7)
            {
                Sis->clientes = Expandir(Sis->clientes, &Sis->Capacidade_Clientes,
                                         Sis->Quantidade_Clientes, sizeof(Cliente));
                Sis->clientes[Sis->Quantidade_Clientes++] = C;   // --> COPIA A STRUCT INTEIRA
            }
        }
        fclose(F);
    }

    // --> PRODUTOS
    F = fopen(Arquivo_Produtos, "r");
    if (F != NULL)
    {
        while (fgets(Linha, sizeof Linha, F) != NULL)
        {
            Produto P;
            Linha[strcspn(Linha, "\r\n")] = '\0';

            if (sscanf(Linha, "%d|%49[^|]|%d|%lf|%lf|%d|%d|%d",
                       &P.Codigo, P.Descricao, &P.Categoria, &P.Preco_Compra,
                       &P.Margem_Lucro, &P.Estoque, &P.Estoque_Minimo,
                       &P.Ativo) == 8
                && P.Categoria >= 1 && P.Categoria <= 3)
            {
                Sis->produtos = Expandir(Sis->produtos, &Sis->Capacidade_Produtos,
                                         Sis->Quantidade_Produtos, sizeof(Produto));
                Sis->produtos[Sis->Quantidade_Produtos++] = P;
            }
        }
        fclose(F);
    }

    // --> VENDAS ( LINHAS V E I MISTURADAS )
    F = fopen(Arquivo_Vendas, "r");
    if (F != NULL)
    {
        while (fgets(Linha, sizeof Linha, F) != NULL)
        {
            Linha[strcspn(Linha, "\r\n")] = '\0';

            if (Linha[0] == 'V')
            {
                Venda V;
                memset(&V, 0, sizeof V);

                if (sscanf(Linha, "V|%d|%c|%lf|%lf|%lf", &V.Numero,
                           &V.Situacao, &V.Percentual_Desconto, &V.SubTotal,
                           &V.Total) == 5)
                {
                    Sis->vendas = Expandir(Sis->vendas, &Sis->Capacidade_Vendas,
                                           Sis->Quantidade_Vendas, sizeof(Venda));
                    Sis->vendas[Sis->Quantidade_Vendas++] = V;
                }
            }
            else if (Linha[0] == 'I' && Sis->Quantidade_Vendas > 0)
            {
                Venda     *V = &Sis->vendas[Sis->Quantidade_Vendas - 1];   // --> ÚLTIMA VENDA LIDA
                Item_Venda It;

                if (sscanf(Linha, "I|%d|%49[^|]|%lf|%d|%lf", &It.Codigo,
                           It.Descricao, &It.Preco_Venda, &It.Quantidade,
                           &It.Total) == 5)
                {
                    V->Itens = Expandir(V->Itens, &V->Capacidade_Itens,
                                        V->Quantidade_Itens, sizeof(Item_Venda));
                    V->Itens[V->Quantidade_Itens++] = It;
                }
            }
        }
        fclose(F);
    }

    // --> PAGAMENTOS
    F = fopen(Arquivo_Pagamentos, "r");
    if (F != NULL)
    {
        while (fgets(Linha, sizeof Linha, F) != NULL)
        {
            Pagamento Pg;
            Linha[strcspn(Linha, "\r\n")] = '\0';

            if (sscanf(Linha, "%d|%lf|%2[^|]|%lf|%lf", &Pg.Numero_Venda,
                       &Pg.Valor_Pago, Pg.Tipo, &Pg.Valor_Dinheiro,
                       &Pg.Valor_Cartao) == 5)
            {
                Sis->pagamentos = Expandir(Sis->pagamentos, &Sis->Capacidade_Pagamentos,
                                           Sis->Quantidade_Pagamentos, sizeof(Pagamento));
                Sis->pagamentos[Sis->Quantidade_Pagamentos++] = Pg;
            }
        }
        fclose(F);
    }

    if (Sis->Quantidade_Produtos == 0)
    {
        Carregar_Produtos_Exemplo(Sis);
    }
}

