// Limpar_Tela --> LIMPA O TERMINAL. O ( #ifdef _WIN32 ) É UMA COMPILAÇÃO CONDICIONAL: SE ESTIVER COMPILANDO NO WINDOWS USA O COMANDO ( cls ),
//                 NOS OUTROS SISTEMAS ( LINUX, MAC ) USA ( clear ). SÓ UMA DAS DUAS LINHAS ENTRA NO PROGRAMA FINAL
//
// Ler_Linha --> É A FUNÇÃO BASE DE LEITURA, TODAS AS OUTRAS LEITURAS PASSAM POR ELA
//     ( fgets ) LÊ UMA LINHA DO TECLADO ( stdin ) COM NO MÁXIMO ( Tamanho - 1 ) CARACTERES. É MAIS SEGURA QUE ( scanf ) E ( gets ) POIS NÃO ESTOURA O BUFFER
//     SE RETORNAR ( NULL ) A ENTRADA ACABOU E O PROGRAMA ENCERRA
//     ( fgets ) GUARDA O ( \n ) DO ENTER NO TEXTO. O ( strcspn( Destino, "\r\n" ) ) ENCONTRA A POSIÇÃO DO PRIMEIRO ( \r ) OU ( \n )
//     E O CÓDIGO COLOCA ( '\0' ) ALI, CORTANDO A QUEBRA DE LINHA
//     ATENÇÃO: NÃO PODE TER ESPAÇO DENTRO DE "\r\n", SENÃO O TEXTO SERIA CORTADO NO PRIMEIRO ESPAÇO
//
// Pausar --> MOSTRA "Pressione ENTER para continuar..." E ESPERA O ENTER COM ( fgets ).
//     SERVE PARA O USUÁRIO CONSEGUIR LER A MENSAGEM ANTES DE O MENU LIMPAR A TELA
//
// Arredondar2 --> ARREDONDA PARA 2 CASAS DECIMAIS. PASSO A PASSO COM ( Valor = 7.456 ):
//     1° 7.456 * 100 = 745.6  /  2° + 0.5 = 746.1  /  3° ( long ) DESCARTA A PARTE DECIMAL = 746  /  4° 746 / 100.0 = 7.46
//     ISSO É IMPORTANTE PARA DINHEIRO, PARA EVITAR RESULTADOS COMO 7.4600000001
//     O ( long ) TRUNCA EM DIREÇÃO AO ZERO, ENTÃO PARA NEGATIVOS A FUNÇÃO ARREDONDA O VALOR POSITIVO E DEPOIS TROCA O SINAL
//
// Ler_Texto --> LÊ UM TEXTO OBRIGATÓRIO. MOSTRA A MENSAGEM E LÊ PARA UM ( Buffer ) GRANDE
//     TROCA TODO ( | ) POR ( - ) PORQUE ( | ) É O SEPARADOR DOS CAMPOS NOS ARQUIVOS ( .txt ) E QUEBRARIA A LEITURA DEPOIS
//     SE FICOU VAZIO AVISA "Campo obrigatorio!" E REPETE ( continue ). SE ESTÁ OK COPIA PARA O ( Destino ) COM ( strncpy ) RESPEITANDO O TAMANHO E GARANTE O '\0'
//     REPARE QUE LÊ PRIMEIRO NUM BUFFER DE 512 E DEPOIS COPIA PARA O CAMPO MENOR: SE O USUÁRIO DIGITAR DEMAIS O TEXTO É CORTADO EM VEZ DE ESTOURAR A MEMÓRIA
//
// Ler_Int --> LÊ UM NÚMERO INTEIRO REPETINDO ATÉ O USUÁRIO DIGITAR ALGO VÁLIDO
//     ( strtol ) CONVERTE TEXTO EM NÚMERO E, PELO PONTEIRO ( Fim ), INFORMA ONDE PAROU DE CONVERTER
//     ( Fim != Buffer ) --> PELO MENOS UM DÍGITO FOI CONVERTIDO ( NÃO DIGITOU SÓ LETRA )
//     ( *Fim == '\0' ) --> CHEGOU AO FIM DO TEXTO SEM SOBRAR LIXO ( "12abc" É RECUSADO )
//     É MUITO MELHOR QUE ( scanf("%d") ), QUE TRAVA OU DEIXA LIXO NO BUFFER QUANDO O USUÁRIO DIGITA LETRAS
//
// Ler_Double --> IGUAL AO ( Ler_Int ) MAS PARA NÚMEROS DECIMAIS, COM ( strtod ).
//     A DIFERENÇA É QUE ANTES ELE TROCA VÍRGULA POR PONTO, PORQUE NO BRASIL SE DIGITA 7,50 MAS A LINGUAGEM C SÓ ENTENDE 7.50
//
// Confirmar --> FAZ UMA PERGUNTA DE SIM OU NÃO. MOSTRA ( Mensagem ( s/n ) ) E OLHA SÓ O PRIMEIRO CARACTERE DIGITADO, EM MINÚSCULO ( tolower ).
//     ( s ) RETORNA 1 ( VERDADEIRO ), ( n ) RETORNA 0 ( FALSO ). QUALQUER OUTRA COISA AVISA E PERGUNTA NOVAMENTE
//
// Expandir --> É A FUNÇÃO MAIS IMPORTANTE DO PROGRAMA. ELA AUMENTA QUALQUER VETOR DINÂMICO QUANDO ELE ENCHE
//     ( void *Vetor ) --> PONTEIRO GENÉRICO, SERVE PARA QUALQUER TIPO ( CLIENTES / PRODUTOS / VENDAS / ETC )
//     ( int *Capacidade ) --> RECEBIDO POR PONTEIRO PARA A FUNÇÃO PODER ALTERAR A CAPACIDADE ORIGINAL
//     ( Quantidade ) --> QUANTOS ELEMENTOS JÁ EXISTEM
//     ( Tamanho ) --> TAMANHO DE CADA ELEMENTO, POR EXEMPLO sizeof( Cliente )
//     O FLUXO: SE ( Quantidade < *Capacidade ) AINDA TEM ESPAÇO E DEVOLVE O VETOR SEM MEXER.
//     SENÃO CALCULA A NOVA CAPACIDADE ( 4 SE ESTAVA EM 0, OU O DOBRO ). ( realloc ) AUMENTA O BLOCO DE MEMÓRIA E COPIA OS DADOS ANTIGOS SE PRECISAR MOVER.
//     SE ( realloc ) FALHAR ( NULL ) MOSTRA O ERRO E ENCERRA. ATUALIZA A ( *Capacidade ) E DEVOLVE O NOVO ENDEREÇO
//     USO: Sis->clientes = Expandir( Sis->clientes, &Sis->Capacidade_Clientes, Sis->Quantidade_Clientes, sizeof( Cliente ) );
//     O ( realloc ) PODE MUDAR O ENDEREÇO DO VETOR, ENTÃO É PRECISO GUARDAR O RETORNO.
//     QUANDO O PONTEIRO COMEÇA EM ( NULL ), O ( realloc ) FUNCIONA COMO UM ( malloc )
//
// Imprimir_Titulo --> DESENHA UMA MOLDURA EM VOLTA DO TÍTULO. O ( %-51s ) RESERVA 51 CARACTERES PARA O TEXTO ALINHADO À ESQUERDA ( O - ),
//     ASSIM O || FINAL FICA SEMPRE NA MESMA COLUNA, QUALQUER QUE SEJA O TAMANHO DO TÍTULO

