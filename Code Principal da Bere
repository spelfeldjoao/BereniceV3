// |------ EXPLICAÇÃO DA PARTE DE VENDAS ------|

// Imprimir_Itens --> IMPRIME A TABELA DE ITENS DE UMA VENDA ( USADA NO RESUMO E NOS RELATÓRIOS )
//
// Adicionar_Item --> ADICIONA UM ITEM AO CARRINHO. RETORNA 0 PARA FINALIZAR E 1 PARA CONTINUAR
//     RECEBE O ÍNDICE DA VENDA ( Iv ) E NÃO UM PONTEIRO, PORQUE O VETOR DE VENDAS PODE SER REALOCADO E UM PONTEIRO ANTIGO FICARIA INVÁLIDO
//     FLUXO: CÓDIGO 0 FINALIZA  /  PRODUTO INEXISTENTE OU DESCONTINUADO É RECUSADO
//     RN03 --> ESTOQUE ZERADO: PRODUTO INDISPONÍVEL
//     RN01 --> ESTOQUE NO MÍNIMO: MOSTRA ALERTA
//     RN02 --> QUANTIDADE MAIOR QUE O ESTOQUE: OFERECE LEVAR SÓ O QUE TEM DISPONÍVEL
//     DEPOIS CONGELA O PREÇO DO MOMENTO, EXPANDE O CARRINHO, PREENCHE O ITEM NA PRÓXIMA POSIÇÃO LIVRE, ATUALIZA O SUBTOTAL E SÓ ENTÃO CONTA O ITEM
//     O ESTOQUE BAIXA NA HORA EM QUE O ITEM ENTRA NO CARRINHO
//
// Registrar_Pagamento --> GRAVA O PAGAMENTO NO VETOR E MARCA A VENDA COMO PAGA ( 'p' ) ( RN04 ). RECEBE O TIPO E AS PARTES EM DINHEIRO E CARTÃO
//
// Consultar_Maquininha --> SIMULA A MAQUININHA: PERGUNTA 1 ( APROVADO ) OU 0 ( REPROVADO ) E REPETE ATÉ RECEBER UM DOS DOIS
//
// Processar_Pagamento --> MOSTRA O MENU DE FORMA DE PAGAMENTO E FICA NELE ATÉ PAGAR ( RETORNA 1 ) OU VOLTAR ( RETORNA 0 )
//     DINHEIRO: SE O RECEBIDO COBRE O TOTAL, MOSTRA O TROCO E REGISTRA SÓ O TOTAL COMO DINHEIRO ( O TROCO NÃO FICA NO CAIXA ) COM TIPO "d"
//     DINHEIRO INSUFICIENTE ( RF09 ): OFERECE PAGAR O RESTANTE NO CARTÃO. SE A MAQUININHA APROVAR, REGISTRA PAGAMENTO MISTO "dc"
//     CARTÃO: SE APROVADO REGISTRA "c". SE REPROVADO VOLTA AO MENU
//
// Nova_Venda --> FLUXO COMPLETO: CARRINHO --> DESCONTO --> RESUMO --> PAGAMENTO
//     CRIA A VENDA JÁ DENTRO DO VETOR. ( memset ) ZERA TUDO ( Itens = NULL, Quantidade_Itens = 0, SubTotal = 0 ) E DEPOIS DEFINE NÚMERO E SITUAÇÃO 'a'
//     O ( while ( Adicionar_Item ) ) NÃO TEM CORPO: A PRÓPRIA FUNÇÃO PEDE OS DADOS E RETORNA 0 QUANDO O OPERADOR DIGITA 0
//     CARRINHO VAZIO CANCELA A VENDA ( LIBERA Itens E DEVOLVE A POSIÇÃO COM Quantidade_Vendas-- )
//     DESCONTO ( RF08 ) DE 0 A 100. TOTAL = SUBTOTAL * ( 1 - DESCONTO / 100 ). EXEMPLO: 100,00 COM 10% --> 90,00
//     DEPOIS PERGUNTA SE QUER PAGAR AGORA. SE NÃO, A VENDA FICA EM ABERTO
//
// Pagar_Venda_Aberta --> RF11. LISTA AS VENDAS COM SITUAÇÃO 'a', PEDE O NÚMERO E CHAMA ( Processar_Pagamento ). SÓ ACEITA VENDA QUE EXISTE E ESTÁ ABERTA
//
// Relatorio_Vendas --> LISTA TODAS AS VENDAS COM ITENS E, PARA CADA UMA, PROCURA EM TODOS OS PAGAMENTOS OS QUE PERTENCEM A ELA ( PELO NÚMERO )

// |------ FIM DA EXPLICAÇÃO DA PARTE DE VENDAS ------|

// |---------------------------------------------------------|

// |------ INICIO DE VENDAS ------|

void Imprimir_Itens(const Venda *V)
{
    printf("\n%-8s %-22s %-10s %-5s %-10s\n",
           "CODIGO", "DESCRICAO", "PRECO", "QTD", "TOTAL");

    for (int i = 0; i < V->Quantidade_Itens; i++)
    {
        printf("%-8d %-22s R$ %-7.2f %-5d R$ %-7.2f\n",
               V->Itens[i].Codigo, V->Itens[i].Descricao,
               V->Itens[i].Preco_Venda, V->Itens[i].Quantidade,
               V->Itens[i].Total);
    }
}

int Adicionar_Item(Sistema *Sis, int Iv)
{
    Venda      *V = &Sis->vendas[Iv];
    Produto    *P;
    Item_Venda *It;
    int         Codigo, Indice, Quantidade;
    double      Preco;

    Codigo = Ler_Int("\nCodigo do produto (0 para finalizar): ");

    if (Codigo == 0)
    {
        return 0;
    }

    Indice = Buscar_Produto(Sis, Codigo);

    if (Indice == -1 || !Sis->produtos[Indice].Ativo)
    {
        printf("Produto nao encontrado ou descontinuado!\n");
        return 1;
    }

    P = &Sis->produtos[Indice];

    // --> RN03 - ESTOQUE ZERADO
    if (P->Estoque <= 0)
    {
        printf("Produto %s indisponivel: estoque zerado!\n", P->Descricao);
        return 1;
    }

    // --> RN01 - ESTOQUE MÍNIMO
    if (P->Estoque <= P->Estoque_Minimo)
    {
        printf("ALERTA: %s atingiu o estoque minimo (%d)! Estoque atual: %d\n",
               P->Descricao, P->Estoque_Minimo, P->Estoque);
    }

    Quantidade = Ler_Int("Quantidade: ");

    if (Quantidade <= 0)
    {
        printf("Quantidade invalida!\n");
        return 1;
    }

    // --> RN02 - QUANTIDADE MAIOR QUE O ESTOQUE
    if (Quantidade > P->Estoque)
    {
        printf("Estoque insuficiente! Disponivel: %d unidade(s).\n", P->Estoque);

        if (!Confirmar("Deseja levar apenas a quantidade disponivel?"))
        {
            printf("Item nao adicionado.\n");
            return 1;
        }

        Quantidade = P->Estoque;
    }

    Preco = Calcular_Preco_Venda(P);   // --> CONGELA O PREÇO DE AGORA

    V->Itens = Expandir(V->Itens, &V->Capacidade_Itens,
                        V->Quantidade_Itens, sizeof(Item_Venda));

    It = &V->Itens[V->Quantidade_Itens];
    It->Codigo = P->Codigo;
    strncpy(It->Descricao, P->Descricao, sizeof It->Descricao - 1);
    It->Descricao[sizeof It->Descricao - 1] = '\0';
    It->Preco_Venda = Preco;
    It->Quantidade  = Quantidade;
    It->Total       = Arredondar2(Preco * Quantidade);

    V->SubTotal = Arredondar2(V->SubTotal + It->Total);
    V->Quantidade_Itens++;

    P->Estoque -= Quantidade;          // --> BAIXA O ESTOQUE NA HORA

    printf("Adicionado: %d x %s a R$ %.2f\n", Quantidade, P->Descricao, Preco);
    printf("Total do carrinho: R$ %.2f\n", V->SubTotal);

    if (P->Estoque <= P->Estoque_Minimo)
    {
        printf("ALERTA: %s esta no estoque minimo! Restam %d.\n",
               P->Descricao, P->Estoque);
    }

    return 1;
}

void Registrar_Pagamento(Sistema *Sis, int Iv, const char *Tipo,
                         double Dinheiro, double Cartao)
{
    Pagamento *Pg;

    Sis->pagamentos = Expandir(Sis->pagamentos, &Sis->Capacidade_Pagamentos,
                               Sis->Quantidade_Pagamentos, sizeof(Pagamento));

    Pg = &Sis->pagamentos[Sis->Quantidade_Pagamentos];
    Pg->Numero_Venda   = Sis->vendas[Iv].Numero;
    Pg->Valor_Pago     = Arredondar2(Dinheiro + Cartao);
    strcpy(Pg->Tipo, Tipo);            // --> Tipo[3] COMPORTA "dc" + '\0'
    Pg->Valor_Dinheiro = Dinheiro;
    Pg->Valor_Cartao   = Cartao;

    Sis->Quantidade_Pagamentos++;
    Sis->vendas[Iv].Situacao = 'p';    // --> A VENDA DEIXA DE ESTAR ABERTA
}

int Consultar_Maquininha(void)
{
    int Status;

    do
    {
        Status = Ler_Int("Maquininha (1 = aprovado, 0 = reprovado): ");
    } while (Status != 0 && Status != 1);

    return Status;
}

int Processar_Pagamento(Sistema *Sis, int Iv)
{
    double Total = Sis->vendas[Iv].Total;
    int    Opcao;

    while (1)
    {
        printf("\n||======================================||\n");
        printf("||          FORMA DE PAGAMENTO          ||\n");
        printf("||======================================||\n");
        printf("|| Total a pagar: R$ %-18.2f ||\n", Total);
        printf("|| 1 - Dinheiro                         ||\n");
        printf("|| 2 - Cartao                           ||\n");
        printf("|| 0 - Voltar (manter venda em aberto)  ||\n");
        printf("||======================================||\n");

        Opcao = Ler_Int("Escolha: ");

        if (Opcao == 0)
        {
            return 0;
        }

        if (Opcao == 1)
        {
            double Recebido = Ler_Double("Valor recebido em dinheiro: R$ ");

            if (Recebido <= 0)
            {
                printf("Valor invalido!\n");
                continue;
            }

            if (Recebido + 0.004 >= Total)
            {
                printf("Troco: R$ %.2f\n", Recebido - Total);
                Registrar_Pagamento(Sis, Iv, "d", Total, 0.0);
                printf("\nCOMPRA CONCLUIDA!\n");
                return 1;
            }

            // --> RF09 - DINHEIRO INSUFICIENTE: OFERECER O RESTANTE EM CARTÃO
            printf("Dinheiro insuficiente! Faltam R$ %.2f.\n", Total - Recebido);

            if (Confirmar("Pagar o restante em cartao?"))
            {
                double Restante = Arredondar2(Total - Recebido);

                if (Consultar_Maquininha() == 1)
                {
                    Registrar_Pagamento(Sis, Iv, "dc", Recebido, Restante);
                    printf("\nPagamento misto registrado. COMPRA CONCLUIDA!\n");
                    return 1;
                }

                printf("Cartao reprovado! Escolha a forma de pagamento novamente.\n");
            }
        }
        else if (Opcao == 2)
        {
            if (Consultar_Maquininha() == 1)
            {
                Registrar_Pagamento(Sis, Iv, "c", 0.0, Total);
                printf("\nCartao aprovado. COMPRA CONCLUIDA!\n");
                return 1;
            }

            printf("Cartao reprovado! Escolha a forma de pagamento novamente.\n");
        }
        else
        {
            printf("Opcao invalida!\n");
        }
    }
}

void Nova_Venda(Sistema *Sis)
{
    Venda *V;
    int    Iv;
    double Perc;

    if (!Verificar_Caixa_Aberto(Sis))
    {
        return;
    }

    if (Sis->Quantidade_Produtos == 0)
    {
        printf("\nNao ha produtos cadastrados!\n");
        Pausar();
        return;
    }

    Sis->vendas = Expandir(Sis->vendas, &Sis->Capacidade_Vendas,
                           Sis->Quantidade_Vendas, sizeof(Venda));

    Iv = Sis->Quantidade_Vendas;
    V  = &Sis->vendas[Iv];
    memset(V, 0, sizeof *V);           // --> ZERA TUDO ( Itens = NULL, contadores = 0 )
    V->Numero   = Iv + 1;
    V->Situacao = 'a';
    Sis->Quantidade_Vendas++;

    Mostrar_Catalogo_Venda(Sis);
    printf("\n--- Venda numero %d ---\n", V->Numero);

    while (Adicionar_Item(Sis, Iv))
    {
        // --> REPETE ATÉ O OPERADOR FINALIZAR O CARRINHO
    }

    if (V->Quantidade_Itens == 0)
    {
        printf("\nCarrinho vazio. Venda cancelada.\n");
        free(V->Itens);
        Sis->Quantidade_Vendas--;      // --> DEVOLVE A POSIÇÃO NO VETOR DE VENDAS
        Pausar();
        return;
    }

    // --> RF08 - DESCONTO INFORMADO
    do
    {
        Perc = Ler_Double("\nDesconto em % (0 para nenhum): ");

        if (Perc < 0 || Perc > 100)
        {
            printf("Percentual invalido! Informe de 0 a 100.\n");
        }
    } while (Perc < 0 || Perc > 100);

    V->Percentual_Desconto = Perc;
    V->Total = Arredondar2(V->SubTotal * (1.0 - Perc / 100.0));

    Imprimir_Titulo("RESUMO DA VENDA");
    Imprimir_Itens(V);
    printf("\nSubtotal : R$ %.2f\n", V->SubTotal);
    printf("Desconto : %.2f%%\n", V->Percentual_Desconto);
    printf("TOTAL    : R$ %.2f\n", V->Total);

    if (Confirmar("\nDeseja pagar agora?"))
    {
        if (!Processar_Pagamento(Sis, Iv))
        {
            printf("\nVenda %d mantida em aberto.\n", V->Numero);
        }
    }
    else
    {
        printf("\nVenda %d mantida em aberto. Use a opcao Pagamento para conclui-la.\n",
               V->Numero);
    }

    Pausar();
}

void Pagar_Venda_Aberta(Sistema *Sis)
{
    int Abertas = 0;
    int Numero, Iv;

    if (!Verificar_Caixa_Aberto(Sis))
    {
        return;
    }

    Imprimir_Titulo("PAGAMENTO DE VENDAS EM ABERTO");

    for (int i = 0; i < Sis->Quantidade_Vendas; i++)
    {
        if (Sis->vendas[i].Situacao == 'a')
        {
            printf("Venda %d - %d item(ns) - Total: R$ %.2f\n",
                   Sis->vendas[i].Numero, Sis->vendas[i].Quantidade_Itens,
                   Sis->vendas[i].Total);
            Abertas++;
        }
    }

    if (Abertas == 0)
    {
        printf("Nao ha vendas em aberto.\n");
        Pausar();
        return;
    }

    Numero = Ler_Int("\nNumero da venda (0 para voltar): ");

    if (Numero == 0)
    {
        return;
    }

    Iv = Buscar_Venda(Sis, Numero);

    if (Iv == -1 || Sis->vendas[Iv].Situacao != 'a')
    {
        printf("Venda aberta nao encontrada!\n");
        Pausar();
        return;
    }

    Imprimir_Itens(&Sis->vendas[Iv]);
    printf("\nTOTAL: R$ %.2f\n", Sis->vendas[Iv].Total);

    Processar_Pagamento(Sis, Iv);
    Pausar();
}

void Relatorio_Vendas(const Sistema *Sis)
{
    Imprimir_Titulo("LISTAGEM DAS VENDAS");

    if (Sis->Quantidade_Vendas == 0)
    {
        printf("Nenhuma venda registrada.\n");
        Pausar();
        return;
    }

    for (int i = 0; i < Sis->Quantidade_Vendas; i++)
    {
        const Venda *V = &Sis->vendas[i];

        printf("\n=== Venda %d - %s ===", V->Numero,
               V->Situacao == 'p' ? "PAGO (p)" : "ABERTO (a)");
        Imprimir_Itens(V);
        printf("Subtotal: R$ %.2f | Desconto: %.2f%% | Total: R$ %.2f\n",
               V->SubTotal, V->Percentual_Desconto, V->Total);

        for (int j = 0; j < Sis->Quantidade_Pagamentos; j++)
        {
            const Pagamento *Pg = &Sis->pagamentos[j];

            if (Pg->Numero_Venda == V->Numero)
            {
                printf("Pagamento: tipo %s | pago R$ %.2f (dinheiro R$ %.2f, cartao R$ %.2f)\n",
                       Pg->Tipo, Pg->Valor_Pago, Pg->Valor_Dinheiro, Pg->Valor_Cartao);
            }
        }
    }

    Pausar();
}

