// |------ EXPLICAÇÃO DA PARTE DE CAIXA ------|

// Saldo_Dinheiro --> DINHEIRO FISICAMENTE NA GAVETA = ABERTURA - SANGRIAS + DINHEIRO RECEBIDO NOS PAGAMENTOS
//     O LAÇO COMEÇA EM ( Inicio_Pagamentos ), ENTÃO SÓ CONTA OS PAGAMENTOS DO CAIXA ATUAL E IGNORA OS DE CAIXAS ANTERIORES
//     USA ( Valor_Dinheiro ) E NÃO ( Valor_Pago ), POIS O TROCO VOLTA PARA O CLIENTE E NÃO FICA NA GAVETA
//
// Verificar_Caixa_Aberto --> GUARDA USADA NO INÍCIO DAS OPERAÇÕES QUE EXIGEM CAIXA ABERTO. RETORNA 1 SE ESTÁ ABERTO, SENÃO AVISA E RETORNA 0
//
// Abrir_Caixa --> RECUSA SE JÁ ESTIVER ABERTO. PEDE O VALOR DE ABERTURA ( FUNDO DE TROCO ) E REPETE ENQUANTO FOR NEGATIVO.
//     ZERA SANGRIAS E AJUSTE. ( Inicio_Pagamentos = Quantidade_Pagamentos ) MARCA ONDE COMEÇAM OS PAGAMENTOS DESTE CAIXA
//     ( TUDO QUE JÁ EXISTE FICA DE FORA DOS CÁLCULOS ). POR FIM ( Caixa_Aberto = 1 )
//
// Retirada_Caixa ( SANGRIA ) --> RETIRA DINHEIRO PRESERVANDO SEMPRE ( Reserva_Troco ) NO CAIXA
//     O VALOR 0.004 É UMA TOLERÂNCIA PARA ERROS DE PONTO FLUTUANTE ( MEIO CENTAVO ), PARA NÃO LIBERAR RETIRADA DE 0,0000001 POR ARREDONDAMENTO
//     SE ( Saldo - Reserva ) NÃO FOR POSITIVO, NÃO HÁ O QUE RETIRAR. SENÃO MOSTRA O MÁXIMO E VALIDA: VALOR > 0 E QUE NÃO DEIXE MENOS QUE A RESERVA
//     A SANGRIA NÃO ALTERA ( Valor_Abertura ): SÓ SOMA EM ( Total_Sangrias ) E A FUNÇÃO ( Saldo_Dinheiro ) JÁ DESCONTA ESSE TOTAL
//
// Buscar_Venda --> BUSCA LINEAR PELO NÚMERO DA VENDA. RETORNA O ÍNDICE OU -1. ATENÇÃO: NÚMERO DA VENDA É DIFERENTE DO ÍNDICE ( Numero = Indice + 1 )
//
// Calcular_Resumo --> PERCORRE OS PAGAMENTOS DO CAIXA ATUAL E MONTA O RESUMO
//     ( memset ) ZERA TODOS OS CAMPOS ANTES DE ACUMULAR. PARA CADA PAGAMENTO: SOMA O TOTAL DA VENDA NO FATURAMENTO E SEPARA O VALOR PAGO PELO TIPO ( d / c / dc )
//     CADA VENDA SÓ PODE SER PAGA UMA VEZ ( Registrar_Pagamento MARCA 'p' E Pagar_Venda_Aberta SÓ ACEITA 'a' ), ENTÃO 1 PAGAMENTO = 1 VENDA
//     CONCILIAÇÃO ( RN07 ) --> Conferencia = Faturamento - Pago_Dinheiro - Pago_Cartao - Pago_Dinheiro_e_Cartao
//     SE TUDO ESTIVER CERTO O RESULTADO É 0. POSITIVO = SOBRA, NEGATIVO = FALTA
//     A ABERTURA NÃO ENTRA NA CONTA PORQUE ELA SERIA SOMADA AO FATURAMENTO E LOGO DEPOIS SUBTRAÍDA ( SE CANCELA ), ENTÃO O RESULTADO É O MESMO
//     NO FINAL, RESULTADO ENTRE -0.005 E 0.005 VIRA 0.0 PARA ELIMINAR RUÍDO DE PONTO FLUTUANTE
//
// Fechar_Caixa --> 1° CONFERE SE ESTÁ ABERTO  /  2° AVISA SE EXISTEM VENDAS EM ABERTO ( NÃO ENTRAM NO FATURAMENTO ). ESSA CONTAGEM OLHA TODAS AS VENDAS DO SISTEMA,
//     POIS UMA VENDA ABERTA DE ANTES CONTINUA PENDENTE  /  3° CALCULA O RESUMO. SE HOUVER DIVERGÊNCIA MOSTRA SOBRA OU FALTA E PERGUNTA SE QUER REGISTRAR O AJUSTE E FECHAR.
//     SE RESPONDER NÃO O CAIXA CONTINUA ABERTO  /  4° IMPRIME O RESUMO E MARCA ( Caixa_Aberto = 0 )

// |------ FIM DA EXPLICAÇÃO DA PARTE DE CAIXA ------|

// |---------------------------------------------------------|

// |------ INICIO DE CAIXA ------|

double Saldo_Dinheiro(const Sistema *Sis)
{
    double Saldo = Sis->Valor_Abertura - Sis->Total_Sangrias;

    for (int i = Sis->Inicio_Pagamentos; i < Sis->Quantidade_Pagamentos; i++)
    {
        Saldo += Sis->pagamentos[i].Valor_Dinheiro;
    }

    return Saldo;
}

int Verificar_Caixa_Aberto(const Sistema *Sis)
{
    if (!Sis->Caixa_Aberto)
    {
        printf("\nO caixa precisa estar aberto!\n");
        Pausar();
        return 0;
    }

    return 1;
}

void Abrir_Caixa(Sistema *Sis)
{
    double Valor;

    Imprimir_Titulo("ABERTURA DE CAIXA");

    if (Sis->Caixa_Aberto)
    {
        printf("O caixa ja esta aberto!\n");
        Pausar();
        return;
    }

    do
    {
        Valor = Ler_Double("Valor para abertura do caixa: R$ ");

        if (Valor < 0)
        {
            printf("Valor invalido! A abertura nao pode ser negativa.\n");
        }
    } while (Valor < 0);

    Sis->Valor_Abertura    = Valor;
    Sis->Total_Sangrias    = 0.0;
    Sis->Ajuste            = 0.0;
    Sis->Inicio_Pagamentos = Sis->Quantidade_Pagamentos;   // --> SÓ CONTAM OS PAGAMENTOS NOVOS
    Sis->Caixa_Aberto      = 1;

    printf("\nCaixa aberto com sucesso! Fundo de troco: R$ %.2f\n", Valor);
    Pausar();
}

void Retirada_Caixa(Sistema *Sis)
{
    double Saldo, Valor;

    if (!Verificar_Caixa_Aberto(Sis))
    {
        return;
    }

    Imprimir_Titulo("RETIRADA DE CAIXA (SANGRIA)");

    Saldo = Saldo_Dinheiro(Sis);
    printf("Dinheiro em caixa: R$ %.2f\n", Saldo);
    printf("Reserva minima para troco: R$ %.2f\n", Reserva_Troco);

    if (Saldo - Reserva_Troco <= 0.004)
    {
        printf("\nNao ha valor disponivel para retirada.\n");
        Pausar();
        return;
    }

    printf("Valor maximo para retirada: R$ %.2f\n", Saldo - Reserva_Troco);
    Valor = Ler_Double("Valor da retirada: R$ ");

    if (Valor <= 0)
    {
        printf("\nValor invalido!\n");
    }
    else if (Saldo - Valor < Reserva_Troco - 0.004)
    {
        printf("\nRetirada bloqueada! Devem permanecer pelo menos R$ %.2f no caixa.\n",
               Reserva_Troco);
    }
    else
    {
        Sis->Total_Sangrias += Valor;
        printf("\nRetirada registrada. Dinheiro restante: R$ %.2f\n",
               Saldo_Dinheiro(Sis));
    }

    Pausar();
}

int Buscar_Venda(const Sistema *Sis, int Numero)
{
    for (int i = 0; i < Sis->Quantidade_Vendas; i++)
    {
        if (Sis->vendas[i].Numero == Numero)
        {
            return i;
        }
    }

    return -1;
}

void Calcular_Resumo(const Sistema *Sis, Resumo_Caixa *R)
{
    memset(R, 0, sizeof *R);

    for (int i = Sis->Inicio_Pagamentos; i < Sis->Quantidade_Pagamentos; i++)
    {
        const Pagamento *Pg = &Sis->pagamentos[i];
        int Iv = Buscar_Venda(Sis, Pg->Numero_Venda);

        R->Quantidade_Vendas++;

        if (Iv != -1)
        {
            R->Faturamento += Sis->vendas[Iv].Total;
        }

        if (strcmp(Pg->Tipo, "d") == 0)       R->Pago_Dinheiro          += Pg->Valor_Pago;
        else if (strcmp(Pg->Tipo, "c") == 0)  R->Pago_Cartao            += Pg->Valor_Pago;
        else                                  R->Pago_Dinheiro_e_Cartao += Pg->Valor_Pago;
    }

    // --> CONCILIAÇÃO ( RN07 ). A ABERTURA SE CANCELARIA NA CONTA, POR ISSO NÃO APARECE AQUI
    R->Conferencia = R->Faturamento - R->Pago_Dinheiro
                     - R->Pago_Cartao - R->Pago_Dinheiro_e_Cartao;

    if (R->Conferencia > -0.005 && R->Conferencia < 0.005)
    {
        R->Conferencia = 0.0;          // --> ELIMINA RUÍDO DE PONTO FLUTUANTE
    }
}

void Fechar_Caixa(Sistema *Sis)
{
    Resumo_Caixa R;
    int          Abertas = 0;

    if (!Verificar_Caixa_Aberto(Sis))
    {
        return;
    }

    Imprimir_Titulo("FECHAMENTO DE CAIXA");

    for (int i = 0; i < Sis->Quantidade_Vendas; i++)
    {
        if (Sis->vendas[i].Situacao == 'a')
        {
            Abertas++;
        }
    }

    if (Abertas > 0)
    {
        printf("Aviso: existem %d venda(s) em aberto no sistema (nao entram no faturamento).\n\n",
               Abertas);
    }

    Calcular_Resumo(Sis, &R);

    if (R.Conferencia != 0.0)
    {
        printf("ATENCAO: ha divergencia de valores no caixa!\n");
        printf("Divergencia: R$ %.2f (%s)\n", R.Conferencia,
               R.Conferencia > 0 ? "sobra" : "falta");

        if (!Confirmar("Deseja registrar o ajuste e fechar o caixa?"))
        {
            printf("\nCaixa mantido aberto.\n");
            Pausar();
            return;
        }

        Sis->Ajuste = R.Conferencia;
    }
    else
    {
        Sis->Ajuste = 0.0;
    }

    printf("\n--------------- RESUMO DO FECHAMENTO ---------------\n");
    printf("Vendas realizadas ............ %d\n", R.Quantidade_Vendas);
    printf("Faturamento do dia ........... R$ %.2f\n", R.Faturamento);
    printf("Valor de abertura ............ R$ %.2f\n", Sis->Valor_Abertura);
    printf("Pago em dinheiro (d) ......... R$ %.2f\n", R.Pago_Dinheiro);
    printf("Pago em cartao (c) ........... R$ %.2f\n", R.Pago_Cartao);
    printf("Pago dinheiro+cartao (dc) .... R$ %.2f\n", R.Pago_Dinheiro_e_Cartao);
    printf("Sangrias realizadas .......... R$ %.2f\n", Sis->Total_Sangrias);
    printf("Dinheiro final em caixa ...... R$ %.2f\n", Saldo_Dinheiro(Sis));
    printf("Conferencia .................. R$ %.2f\n", R.Conferencia);

    if (Sis->Ajuste > 0)       printf("Ajuste ....................... R$ %.2f (sobra)\n", Sis->Ajuste);
    else if (Sis->Ajuste < 0)  printf("Ajuste ....................... R$ %.2f (falta)\n", Sis->Ajuste);
    else                       printf("Ajuste ....................... nenhum (fechamento correto)\n");

    Sis->Caixa_Aberto = 0;
    printf("\nCaixa fechado com sucesso!\n");
    Pausar();
}

