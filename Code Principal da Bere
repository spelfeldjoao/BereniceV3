// Ler_Cpf --> LÊ UM CPF COM 11 DÍGITOS E O GRAVA FORMATADO
//     USA ( Ler_Texto ) PARA PEGAR O QUE FOI DIGITADO E COPIA SÓ OS DÍGITOS ( isdigit ) PARA ( Digitos ), IGNORANDO PONTOS, TRAÇOS E ESPAÇOS
//     O ( Qtd < 11 ) EVITA ESTOURAR O VETOR SE DIGITAREM MAIS QUE 11 NÚMEROS
//     COM 11 DÍGITOS, ( sprintf ) MONTA O TEXTO FORMATADO. O ( %.3s ) IMPRIME NO MÁXIMO 3 CARACTERES DA STRING,
//     ENTÃO "12345678901" VIRA "123.456.789-01". ( Digitos + 3 ) É O ENDEREÇO DO QUARTO CARACTERE, E ASSIM POR DIANTE
//     NÃO CONFERE OS DÍGITOS VERIFICADORES, SÓ A QUANTIDADE
//
// Cadastrar_Cliente --> CADASTRA UM NOVO CLIENTE NO FIM DO VETOR
//     1° ( Expandir ) GARANTE ESPAÇO PARA MAIS UM  /  2° ( C ) APONTA PARA A PRÓXIMA POSIÇÃO LIVRE E O CÓDIGO É SEQUENCIAL ( QUANTIDADE + 1 )
//     3° PEDE CADA CAMPO COM ( Ler_Texto ) E ( Ler_Cpf )  /  4° SÓ NO FINAL FAZ ( Quantidade_Clientes++ ), ASSIM O CLIENTE SÓ É CONTADO DEPOIS DE PREENCHIDO
//
// Relatorio_Clientes --> LISTA TODOS OS CLIENTES. O ( const ) NO PARÂMETRO GARANTE QUE A FUNÇÃO SÓ LÊ, NÃO ALTERA O SISTEMA

// |------ FIM DA EXPLICAÇÃO DA PARTE DE CLIENTES ------|

// |---------------------------------------------------------|

// |------ INICIO DE CLIENTES ------|

void Ler_Cpf(char *Destino)
{
    char Buffer[Tamanho_Linha];
    char Digitos[12];                  // --> 11 DÍGITOS + '\0'
    int  Qtd;

    while (1)
    {
        Ler_Texto("CPF (11 digitos): ", Buffer, sizeof Buffer);

        Qtd = 0;
        for (size_t i = 0; Buffer[i] != '\0'; i++)
        {
            if (isdigit((unsigned char)Buffer[i]) && Qtd < 11)
            {
                Digitos[Qtd++] = Buffer[i];
            }
        }
        Digitos[Qtd] = '\0';

        if (Qtd == 11)
        {
            sprintf(Destino, "%.3s.%.3s.%.3s-%.2s",
                    Digitos, Digitos + 3, Digitos + 6, Digitos + 9);
            return;
        }

        printf("CPF invalido! Informe 11 digitos.\n");
    }
}

