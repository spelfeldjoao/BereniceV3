void Limpar_Tela(void)
{
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

void Ler_Linha(char *Destino, int Tamanho)
{
    if (fgets(Destino, Tamanho, stdin) == NULL)
    {
        printf("\nEntrada encerrada!\n");
        exit(0);
    }
    Destino[strcspn(Destino, "\r\n")] = '\0';   // --> REMOVE A QUEBRA DE LINHA ( SEM ESPAÇO NO CONJUNTO )
}

void Pausar(void)
{
    char Buffer[Tamanho_Linha];

    printf("\nPressione ENTER para continuar...");
    if (fgets(Buffer, sizeof Buffer, stdin) == NULL)
    {
        return;
    }
}

double Arredondar2(double Valor)
{
    if (Valor < 0)
    {
        return -Arredondar2(-Valor);   // --> NEGATIVO: ARREDONDA O POSITIVO E INVERTE O SINAL
    }

    return (double)((long)(Valor * 100.0 + 0.5)) / 100.0;
}

void Ler_Texto(const char *Mensagem, char *Destino, int Tamanho)
{
    char Buffer[Tamanho_Linha];

    while (1)
    {
        printf("%s", Mensagem);
        Ler_Linha(Buffer, sizeof Buffer);

        for (size_t i = 0; Buffer[i] != '\0'; i++)
        {
            if (Buffer[i] == '|')
            {
                Buffer[i] = '-';       // --> '|' SEPARA OS CAMPOS NOS ARQUIVOS
            }
        }

        if (strlen(Buffer) == 0)
        {
            printf("Campo obrigatorio!\n");
            continue;
        }

        strncpy(Destino, Buffer, Tamanho - 1);
        Destino[Tamanho - 1] = '\0';   // --> GARANTE O FIM DA STRING
        return;
    }
}

int Ler_Int(const char *Mensagem)
{
    char  Buffer[Tamanho_Linha];
    char *Fim;
    long  Valor;

    while (1)
    {
        printf("%s", Mensagem);
        Ler_Linha(Buffer, sizeof Buffer);

        Valor = strtol(Buffer, &Fim, 10);

        while (*Fim == ' ')
        {
            Fim++;                     // --> IGNORA ESPAÇOS NO FINAL
        }

        if (Fim != Buffer && *Fim == '\0')
        {
            return (int)Valor;
        }

        printf("Valor invalido! Digite um numero inteiro.\n");
    }
}

double Ler_Double(const char *Mensagem)
{
    char   Buffer[Tamanho_Linha];
    char  *Fim;
    double Valor;

    while (1)
    {
        printf("%s", Mensagem);
        Ler_Linha(Buffer, sizeof Buffer);

        for (size_t i = 0; Buffer[i] != '\0'; i++)
        {
            if (Buffer[i] == ',')
            {
                Buffer[i] = '.';       // --> ACEITA VÍRGULA COMO SEPARADOR DECIMAL
            }
        }

        Valor = strtod(Buffer, &Fim);

        while (*Fim == ' ')
        {
            Fim++;
        }

        if (Fim != Buffer && *Fim == '\0')
        {
            return Valor;
        }

        printf("Valor invalido! Digite um numero.\n");
    }
}

int Confirmar(const char *Mensagem)
{
    char Buffer[Tamanho_Linha];

    while (1)
    {
        printf("%s (s/n): ", Mensagem);
        Ler_Linha(Buffer, sizeof Buffer);

        if (tolower((unsigned char)Buffer[0]) == 's') return 1;
        if (tolower((unsigned char)Buffer[0]) == 'n') return 0;

        printf("Responda com s ou n.\n");
    }
}

void *Expandir(void *Vetor, int *Capacidade, int Quantidade, size_t Tamanho)
{
    int   Nova_Capacidade;
    void *Novo;

    if (Quantidade < *Capacidade)
    {
        return Vetor;                  // --> AINDA TEM ESPAÇO
    }

    Nova_Capacidade = (*Capacidade == 0) ? Capacidade_Inicial : *Capacidade * 2;
    Novo = realloc(Vetor, (size_t)Nova_Capacidade * Tamanho);

    if (Novo == NULL)
    {
        printf("Erro: memoria insuficiente!\n");
        exit(1);
    }

    *Capacidade = Nova_Capacidade;
    return Novo;
}

void Imprimir_Titulo(const char *Titulo)
{
    printf("\n||=====================================================||\n");
    printf("|| %-51s ||\n", Titulo);
    printf("||=====================================================||\n");
}

