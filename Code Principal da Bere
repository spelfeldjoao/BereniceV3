int Buscar_Produto(const Sistema *Sis, int Codigo)
{
    for (int i = 0; i < Sis->Quantidade_Produtos; i++)
    {
        if (Sis->produtos[i].Codigo == Codigo)
        {
            return i;
        }
    }

    return -1;
}

double Calcular_Preco_Venda(const Produto *P)
{
    return Arredondar2(P->Preco_Compra * (1.0 + P->Margem_Lucro / 100.0));
}

void Inserir_Produto(Sistema *Sis, int Codigo, const char *Descricao,
                     int Categoria, double Compra, double Margem,
                     int Estoque, int Minimo)
{
    Produto *P;

    Sis->produtos = Expandir(Sis->produtos, &Sis->Capacidade_Produtos,
                             Sis->Quantidade_Produtos, sizeof(Produto));

    P = &Sis->produtos[Sis->Quantidade_Produtos];
    P->Codigo         = Codigo;
    strncpy(P->Descricao, Descricao, sizeof P->Descricao - 1);
    P->Descricao[sizeof P->Descricao - 1] = '\0';
    P->Categoria      = Categoria;
    P->Preco_Compra   = Compra;
    P->Margem_Lucro   = Margem;
    P->Estoque        = Estoque;
    P->Estoque_Minimo = Minimo;
    P->Ativo          = 1;             // --> TODO PRODUTO NOVO NASCE ATIVO

    Sis->Quantidade_Produtos++;
}

void Carregar_Produtos_Exemplo(Sistema *Sis)
{
