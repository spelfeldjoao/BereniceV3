// |------ EXPLICAÇÃO DA PARTE DO MAIN ------|

// ( Sistema Sis ) É A ÚNICA VARIÁVEL DO PROGRAMA, CRIADA AQUI E PASSADA POR PONTEIRO ( &Sis ) PARA AS FUNÇÕES
// ( memset ) ZERA TUDO: OS PONTEIROS FICAM NULL E OS CONTADORES 0, QUE É O ESTADO CORRETO PARA A FUNÇÃO ( Expandir ) COMEÇAR A ALOCAR DO ZERO
// ORDEM: Carregar_Dados ( PREPARA AS ESTRUTURAS E LÊ OS ARQUIVOS, SE HOUVER ) --> Abrir_Caixa ( O FLUXO COMEÇA COM A ABERTURA )
//        --> Menu_Principal --> Liberar_Sistema ( DEVOLVE A MEMÓRIA ANTES DE ENCERRAR )

// |------ FIM DA EXPLICAÇÃO DA PARTE DO MAIN ------|

// |---------------------------------------------------------|

// |------ INICIO DO MAIN ------|

int main(void)
{
    Sistema Sis;

    memset(&Sis, 0, sizeof Sis);

    Carregar_Dados(&Sis);
    Abrir_Caixa(&Sis);
    Menu_Principal(&Sis);
    Liberar_Sistema(&Sis);

    return 0;
}

