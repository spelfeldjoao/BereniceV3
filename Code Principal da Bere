    Inserir_Produto(Sis, 1001, "Esponja",       Categoria_Limpeza,      2.30, 30.0, 30, 5);
    Inserir_Produto(Sis, 1002, "Biscoito doce", Categoria_Panificacao, 10.00, 25.0,  5, 5);
}

void Cadastrar_Produto(Sistema *Sis)
{
    int    Codigo, Categoria, Estoque, Minimo;
    double Compra, Margem;
    char   Descricao[50];

    Imprimir_Titulo("CADASTRO DE PRODUTO");

    while (1)
    {
        Codigo = Ler_Int("Codigo do produto: ");

        if (Codigo <= 0)
        {
            printf("O codigo deve ser maior que zero!\n");
        }
        else if (Buscar_Produto(Sis, Codigo) != -1)
        {
            printf("Ja existe um produto com esse codigo!\n");
        }
        else
        {
            break;
        }
    }

    Ler_Texto("Descricao: ", Descricao, sizeof Descricao);

    do
    {
        Categoria = Ler_Int("Categoria (1-Alimentos 2-Material de Limpeza 3-Panificacao): ");
    } while (Categoria < 1 || Categoria > 3);

    do
    {
        Compra = Ler_Double("Preco de compra: R$ ");
    } while (Compra <= 0);

    do
    {
        Margem = Ler_Double("Margem de lucro (%): ");
    } while (Margem < 0);

    do
    {
        Estoque = Ler_Int("Quantidade em estoque: ");
    } while (Estoque < 0);

    do
    {
        Minimo = Ler_Int("Estoque minimo: ");
    } while (Minimo < 0);

    Inserir_Produto(Sis, Codigo, Descricao, Categoria, Compra, Margem, Estoque, Minimo);

    printf("\nProduto cadastrado! Preco de venda atual: R$ %.2f\n",
           Calcular_Preco_Venda(&Sis->produtos[Sis->Quantidade_Produtos - 1]));
    Pausar();
}

void Alterar_Margem(Sistema *Sis)
{
    int      Indice;
    double   Margem;
    Produto *P;

    Imprimir_Titulo("ALTERAR MARGEM DE LUCRO");

    Indice = Buscar_Produto(Sis, Ler_Int("Codigo do produto: "));

    if (Indice == -1)
    {
        printf("Produto nao encontrado!\n");
        Pausar();
        return;
    }

    P = &Sis->produtos[Indice];
    printf("%s - margem atual: %.2f%% - preco de venda: R$ %.2f\n",
           P->Descricao, P->Margem_Lucro, Calcular_Preco_Venda(P));

    do
    {
        Margem = Ler_Double("Nova margem (%): ");
    } while (Margem < 0);

    P->Margem_Lucro = Margem;
    printf("Novo preco de venda: R$ %.2f\n", Calcular_Preco_Venda(P));
    Pausar();
}

void Descontinuar_Produto(Sistema *Sis)
{
    int Indice;

    Imprimir_Titulo("DESCONTINUAR PRODUTO");

    Indice = Buscar_Produto(Sis, Ler_Int("Codigo do produto: "));

    if (Indice == -1)
    {
        printf("Produto nao encontrado!\n");
    }
    else if (!Sis->produtos[Indice].Ativo)
    {
        printf("Este produto ja esta descontinuado.\n");
    }
    else if (Confirmar("Confirma a descontinuacao?"))
    {
        Sis->produtos[Indice].Ativo = 0;
        printf("Produto descontinuado (continua no historico das vendas).\n");
    }

    Pausar();
}

